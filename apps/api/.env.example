# AutoCollect AI — API environment
# Copy to apps/api/.env for local development. Every external service falls
# back to a local mock when its keys are empty, so the app runs fully offline.
# Production requirements are enforced at startup (see docs/PRODUCTION.md).

# development | test  -> mocks + dev routes enabled
# anything else       -> production rules (dev routes off, required secrets checked)
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
# Local: the docker-compose superuser (not a secret).
DATABASE_URL=postgres://autocollect:autocollect_dev@localhost:5433/autocollect
# Production: DATABASE_URL = RLS-enforced role `autocollect_app` (npm run db:roles),
# SERVICE_DATABASE_URL = BYPASSRLS role `autocollect_service` for webhooks/jobs,
# MIGRATION_DATABASE_URL = the table owner, used only by `db:migrate` / `db:roles`.
# SERVICE_DATABASE_URL=postgres://autocollect_service:<password>@host:5432/autocollect
# MIGRATION_DATABASE_URL=postgres://autocollect:<password>@host:5432/autocollect
# DB_POOL_MAX=10
# DB_SERVICE_POOL_MAX=5
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_SSL=false
# DB_IDLE_TIMEOUT_MS=30000

# ── URLs ────────────────────────────────────────────────────────────────────
# Where the SPA is served (comma-separate several). Used for CORS, CSRF and links in emails.
WEB_ORIGIN=http://localhost:5175
# Public URL of this API. When the API is under /api (Docker single image / Vercel)
# use https://<domain>/api. OAuth redirect URIs are built from it.
APP_URL=http://localhost:4000
# Single-container mode: serve the built SPA and mount the API under /api.
# SERVE_WEB_DIR=../web/dist
# Behind a load balancer/proxy: number of trusted hops (default 1 in production).
# TRUST_PROXY=1

# ── Security (all required in production) ──────────────────────────────────
# Exactly 32 characters. Encrypts stored OAuth tokens (AES-256-GCM).
CREDENTIALS_ENCRYPTION_KEY=
# 32+ random characters. Signs OAuth state and reply-routing addresses.
OAUTH_STATE_SECRET=
# 32+ random characters. Vercel Cron sends it as `Authorization: Bearer ...`.
CRON_SECRET=
# 24+ random characters, shared by BOTH Postmark webhooks (not the server token):
#   inbound replies:  <APP_URL>/inbound/postmark?token=<this>
#   delivery events:  <APP_URL>/email/webhook/postmark?token=<this>
POSTMARK_WEBHOOK_TOKEN=
# Platform admin (portal at /admin/login). 12+ characters in production.
SUPER_ADMIN_EMAIL=admin@autocollect.local
SUPER_ADMIN_PASSWORD=admin123
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# SESSION_TTL_HOURS=720

# ── Email ───────────────────────────────────────────────────────────────────
# auto: Postmark when POSTMARK_SERVER_TOKEN is set, otherwise log emails to the console.
# ethereal: free SMTP sandbox with preview links (dev only). Production requires Postmark.
EMAIL_PROVIDER=auto
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=no-reply@yourdomain.com
# Alternative to Postmark: any SMTP server (Gmail app password, Brevo, Amazon SES…).
# Bounce/complaint webhooks and inbound reply handling are Postmark-only.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM_ADDRESS=you@gmail.com
EMAIL_FROM_NAME=AutoCollect AI
# POSTMARK_MESSAGE_STREAM=outbound
# Postmark inbound address. Reminders use Reply-To <local>+<signed invoice ref>@<domain>
# so customer replies land on the right invoice. e.g. abc123@inbound.postmarkapp.com
INBOUND_REPLY_ADDRESS=

# ── Stripe (Connect + platform billing) ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
# Signing secret(s) — Stripe issues one per endpoint. Put the Connect endpoint's
# secret here and the platform-billing endpoint's secret below (or comma-separate).
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_WEBHOOK_SECRET=
BILLING_GROWTH_PRICE_ID=
BILLING_PRO_PRICE_ID=
BILLING_AGENCY_PRICE_ID=

# ── Optional integrations ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENV=sandbox
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Background work ─────────────────────────────────────────────────────────
# Long-lived hosts run the scheduler in-process. Set false on extra web replicas
# if you run a dedicated worker, or on serverless (use /api/cron/dunning instead).
RUN_SCHEDULER=true
DUNNING_SCAN_INTERVAL_MS=60000
# DUNNING_BATCH_SIZE=200
# DUNNING_TIME_BUDGET_MS=45000
# QBO_SYNC_INTERVAL_MS=900000

# ── Rate limiting ───────────────────────────────────────────────────────────
# Shared counter store so limits hold across instances. Strongly recommended on
# Vercel / multiple replicas (Upstash: use the rediss:// TLS URL). Empty = per instance.
REDIS_URL=

# ── Monitoring ──────────────────────────────────────────────────────────────
# Receives a JSON POST for every unhandled 5xx (Slack/Discord webhook, etc.).
ERROR_WEBHOOK_URL=
# PROVIDER_TIMEOUT_MS=15000
