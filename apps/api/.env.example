# AutoCollect AI API environment
# Copy to .env and fill in. Local dev works without external keys.

NODE_ENV=development
PORT=4000

# Database (matches docker-compose.yml)
DATABASE_URL=postgres://autocollect:***@localhost:5433/autocollect
# Production: point at the RLS-enforced runtime role created by `npm run db:roles`.
# Background/scheduler work uses this BYPASSRLS service role (defaults to DATABASE_URL).
# SERVICE_DATABASE_URL=postgres://autocollect_service:***@localhost:5433/autocollect

# CORS origin for the SPA
WEB_ORIGIN=http://localhost:5175

# --- Security hardening (Phase 3) -----------------------------------------
# Exactly 32 characters. When unset, OAuth tokens are stored in plaintext (dev only).
CREDENTIALS_ENCRYPTION_KEY=
# HMAC secret for OAuth state tokens (required in production).
OAUTH_STATE_SECRET=
# Shared secret for BOTH Postmark webhooks (required in production):
#   inbound replies:  https://<api>/inbound/postmark?token=<this>
#   delivery events:  https://<api>/email/webhook/postmark?token=<this>
# Any long random string. It is NOT the Postmark server token.
POSTMARK_WEBHOOK_TOKEN=

# --- Stripe (M2) ---------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PLATFORM_ACCOUNT_ID=
STRIPE_CONNECT_CLIENT_ID=
# Signing secret of the webhook endpoint (starts with whsec_). Locally, the
# value printed by `stripe listen`; in production, from the endpoint's page in
# the Stripe Dashboard. NOT the account id (acct_...).
STRIPE_WEBHOOK_SECRET=
# Public origin of this API. On Vercel the API lives under /api, so use
# https://<your-domain>/api. Stripe/Google OAuth redirect URIs are built from it.
APP_URL=http://localhost:4000

# Platform billing (self-serve subscriptions, Phase 2)
# Stripe Price IDs for the monthly paid plans (mode=subscription).
BILLING_GROWTH_PRICE_ID=
BILLING_PRO_PRICE_ID=
BILLING_AGENCY_PRICE_ID=

# --- Twilio SMS (Phase 2) --------------------------------------------------
# When unset, SMS runs in mock mode (sends recorded, no carrier call).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Postmark (M3) -------------------------------------------------------
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=no-reply@ar.autocollect.dev

# --- QuickBooks Online (Phase 2) ------------------------------------------
# When unset, QBO runs in mock mode (fake realm + generated invoices).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENV=sandbox

# --- Anthropic (M4) ------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Google OAuth (M5) -----------------------------------------------------
# Google OAuth Client ID and Secret for Gmail login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Monitoring (Phase 3) -------------------------------------------------
# Optional webhook that receives a JSON payload on unhandled 5xx errors (prod only).
ERROR_WEBHOOK_URL=

# --- Serverless cron (Vercel) --------------------------------------------
# Secret for `/api/cron/dunning`. Vercel Cron sends it automatically as
# `Authorization: Bearer <CRON_SECRET>`; other schedulers can use the
# `x-cron-secret` header. Use a long random string — never reuse an API key.
# Required on Vercel (serverless has no in-process scheduler).
CRON_SECRET=