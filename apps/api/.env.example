# AutoCollect AI API environment
# Copy to .env and fill in. Local dev works without external keys.

NODE_ENV=development
PORT=4000

# Database (matches docker-compose.yml)
DATABASE_URL=postgres://autocollect:***@localhost:5433/autocollect
# Production: point at the RLS-enforced runtime role created by `npm run db:roles`.
# Background/scheduler work uses this BYPASSRLS service role (defaults to DATABASE_URL).
# SERVICE_DATABASE_URL=postgres://autocollect_service:***@localhost:5433/autocollect

# CORS origin for the SPA
WEB_ORIGIN=http://localhost:5175

# --- Security hardening (Phase 3) -----------------------------------------
# Exactly 32 characters. When unset, OAuth tokens are stored in plaintext (dev only).
CREDENTIALS_ENCRYPTION_KEY=
# HMAC secret for OAuth state tokens (required in production).
OAUTH_STATE_SECRET=
# Shared token for the Postmark inbound webhook (optional; when set it must be
# sent as `?token=` or `X-Postmark-Server-Token`).
POSTMARK_WEBHOOK_TOKEN=

# --- Auth (optional in dev) ---------------------------------------------
# Clerk requires a secret key. When unset, a DEV auth mode is enabled that
# accepts a "x-dev-user" header so you can test tenant flows locally.
CLERK_SECRET_KEY=
CLERK_ISSUER=

# --- Stripe (M2) ---------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PLATFORM_ACCOUNT_ID=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:4000

# Platform billing (self-serve subscriptions, Phase 2)
# Stripe Price IDs for the monthly paid plans (mode=subscription).
BILLING_GROWTH_PRICE_ID=
BILLING_PRO_PRICE_ID=
BILLING_AGENCY_PRICE_ID=

# --- Twilio SMS (Phase 2) --------------------------------------------------
# When unset, SMS runs in mock mode (sends recorded, no carrier call).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Postmark (M3) -------------------------------------------------------
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=no-reply@ar.autocollect.dev

# --- QuickBooks Online (Phase 2) ------------------------------------------
# When unset, QBO runs in mock mode (fake realm + generated invoices).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENV=sandbox

# --- Anthropic (M4) ------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Google OAuth (M5) -----------------------------------------------------
# Google OAuth Client ID and Secret for Gmail login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Monitoring (Phase 3) -------------------------------------------------
# Optional webhook that receives a JSON payload on unhandled 5xx errors (prod only).
ERROR_WEBHOOK_URL=

# --- Serverless cron (Vercel) --------------------------------------------
# Secret that the `/api/cron/dunning` route checks via the `x-cron-secret` header.
# Required if you rely on Vercel cron to run the dunning scan instead of the
# in-process scheduler (long-lived host).
CRON_SECRET=