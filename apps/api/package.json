{
  "name": "@autocollect/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:roles": "tsx src/scripts/bootstrap-roles.ts",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@autocollect/shared": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-raw-body": "^6.0.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "stripe": "^22.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
