{
  "name": "@autocollect/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "db:roles": "tsx src/scripts/bootstrap-roles.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "dev:serve": "tsx src/server.ts"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@autocollect/shared": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/csrf-protection": "^4.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^10.1.5",
    "argon2": "^0.45.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.1.0",
    "fastify-raw-body": "^6.0.1",
    "jose": "^5.9.6",
    "nodemailer": "^10.0.15",
    "pg": "^8.13.1",
    "stripe": "^22.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
